# InspectAI System Environment Configuration
HOST=0.0.0.0
PORT=8000

# Trained ONNX Model Path
MODEL_PATH=models/inspectai_yolo11n.onnx

# Mobile Phone IP Camera Stream
# Example Android IP Webcam app: http://192.168.1.100:8080/video
# Example Local Webcam index: 0
CAMERA_URL=http://192.168.1.100:8080/video

# Inspection & Detection Parameters
CAPTURE_INTERVAL=1.0
CONFIDENCE_THRESHOLD=0.25
IOU_THRESHOLD=0.45

# Rolling Retention Policy (Seconds)
RETENTION_PERIOD=100

